<ui:FluentWindow x:Class="WpfUiSample.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
                 Title="亮度工具 (WPF-UI 示例)"
                 Width="320" Height="220">
    <StackPanel Margin="24">
        <TextBlock x:Name="ValueText"
                   Text="亮度: 0"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   Margin="0,0,0,12" />

        <ui:Slider x:Name="BrightnessSlider"
                   Minimum="0" Maximum="100"
                   StepFrequency="1"
                   ValueChanged="BrightnessSlider_ValueChanged" />

        <ui:Button Content="应用亮度"
                   Click="ApplyButton_Click"
                   Margin="0,16,0,0" />
    </StackPanel>
</ui:FluentWindow>