<Application x:Class="WpfUiSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Wpf.Ui;assembly=Wpf.Ui"
             xmlns:uictrl="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ui:ThemeResources EnableMicaBackdrop="True" />
        <uictrl:FluentWindow.Resources>
            <uictrl:FluentWindowGlobalStyle />
        </uictrl:FluentWindow.Resources>
    </Application.Resources>
</Application>